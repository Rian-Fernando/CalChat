# Upstash Redis (free tier at https://upstash.com or via Vercel marketplace)
# These env vars are also automatically set if you add the Upstash integration on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Feedex feedback widget (https://feedex.rianfernando.com) — optional.
# Publishable key from Dashboard → Projects → your project → Install. It's safe
# in client HTML; it can only file feedback against its own project. Leave it
# unset and the widget simply isn't rendered.
NEXT_PUBLIC_FEEDEX_KEY=
